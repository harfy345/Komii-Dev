    "claude-code",
    "github-copilot",
    "cursor",
    "vscode",
    "cli"
  ],
  "author": "harfy345",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harfy345/Komii-Dev.git"
  },
  "homepage": "https://github.com/harfy345/Komii-Dev#readme",
  "bugs": {
    "url": "https://github.com/harfy345/Komii-Dev/issues"
  },
